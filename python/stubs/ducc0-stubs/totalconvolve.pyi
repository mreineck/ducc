from typing import List, overload

from ._typing import Complex32Array, Complex64Array, Float32Array, Float64Array

class ConvolverPlan:
    @overload
    def __init__(self, lmax: int, kmax: int, npoints: int, sigma_min: float, sigma_max: float, epsilon: float, nthreads: int = ...) -> None: ...
    @overload
    def __init__(self, lmax: int, kmax: int, sigma: float, epsilon: float, nthreads: int = ...) -> None: ...
    @overload
    def __init__(self, lmax: int, kmax: int, *, epsilon: float, npoints: int = ..., sigma_min: float = ..., sigma_max: float = ..., nthreads: int = ...) -> None: ...
    def Ntheta(self) -> int: ...
    def Nphi(self) -> int: ...
    def Npsi(self) -> int: ...
    def getPatchInfo(self, theta_lo: float, theta_hi: float, phi_lo: float, phi_hi: float) -> List[int]: ...
    def getPlane(self, slm: Complex64Array, blm: Complex64Array, mbeam: int, planes: Complex64Array) -> None: ...
    def prepPsi(self, subcube: Complex64Array) -> None: ...
    def deprepPsi(self, subcube: Complex64Array) -> None: ...
    def interpol(self, cube: Complex64Array, itheta0: int, iphi0: int, theta: Float64Array, phi: Float64Array, psi: Float64Array, signal: Complex64Array) -> None: ...
    def deinterpol(self, cube: Complex64Array, itheta0: int, iphi0: int, theta: Float64Array, phi: Float64Array, psi: Float64Array, signal: Complex64Array) -> None: ...
    def updateSlm(self, slm: Complex64Array, blm: Complex64Array, mbeam: int, planes: Complex64Array) -> None: ...

