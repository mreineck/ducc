    @overload
    def __init__(self, lmax: int, kmax: int, ncomp: int, npoints: int, sigma_min: float, sigma_max: float, epsilon: float, nthreads: int = ...) -> None: ...
    @overload
    def __init__(self, sky: Complex64Array, beam: Complex64Array, separate: bool, lmax: int, kmax: int, epsilon: float, ofactor: float = ..., nthreads: int = ...) -> None: ...
    @overload
    def __init__(self, lmax: int, kmax: int, ncomp: int, epsilon: float, ofactor: float = ..., nthreads: int = ...) -> None: ...
    @overload
