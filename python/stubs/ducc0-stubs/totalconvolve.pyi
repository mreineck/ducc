    @overload
    def __init__(self, lmax: int, kmax: int, ncomp: int, *, epsilon: float, npoints: int = ..., sigma_min: float = ..., sigma_max: float = ..., nthreads: int = ...) -> None: ...
    def interpol(self, ptg: Float64Array) -> Complex64Array: ...
    def deinterpol(self, ptg: Float64Array, data: Complex64Array) -> None: ...
    def getSlm(self, beam: Complex64Array) -> Complex64Array: ...

